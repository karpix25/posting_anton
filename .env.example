# Yandex Disk Token
# Получить можно через OAuth приложение Яндекс: https://oauth.yandex.ru/
YANDEX_TOKEN=your_yandex_oauth_token

# OpenAI API Key
# Для генерации текстов (GPT-4)
OPENAI_API_KEY=sk-proj-...

# Upload Post API Key
# Для публикации видео и синхронизации профилей
# Получить в сервисе Upload Post
UPLOAD_POST_API_KEY=your_upload_post_api_key

# Postgres Connection (для KPI монтажеров и статистики)
# Пример: postgres://admin:password@host:5432/postgres?sslmode=disable
# Если оставить пустым, будет использоваться тестовое значение
DATABASE_URL=

# Telegram Bot
# Создать бота можно через @BotFather
TELEGRAM_BOT_TOKEN=123456:telegram_bot_token

# Telegram user id администраторов через запятую, для /admin_report
TELEGRAM_ADMIN_IDS=123456789

# Запускать polling прямо внутри API-сервиса. Для EasyPanel с одним сервисом оставьте true.
TELEGRAM_BOT_AUTO_START=true

# Telegram Web Login для защиты админ-панели
# username бота БЕЗ @ (например: takemerolikbot)
TELEGRAM_WEB_LOGIN_BOT_USERNAME=your_bot_username
# Включить web-авторизацию через Telegram
TELEGRAM_WEB_AUTH_ENABLED=true
# Имя cookie сессии
TELEGRAM_WEB_AUTH_COOKIE_NAME=posting_admin_session
# Время жизни сессии (сек)
TELEGRAM_WEB_AUTH_TTL_SECONDS=86400
# Отдельный секрет подписи web-сессии (рекомендуется задать вручную)
TELEGRAM_WEB_AUTH_SECRET=replace_with_long_random_secret
# Делать cookie secure на HTTPS (рекомендуется true)
TELEGRAM_WEB_AUTH_STRICT_HTTPS=true
